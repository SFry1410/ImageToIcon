<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RootNamespace>ImageToIcon.Library</RootNamespace>
        <AssemblyName>ImageToIcon.Library</AssemblyName>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Description>Writes multi-size icons into a resource-only icon library DLL.</Description>
        <Company>Roy Bock</Company>
        <Product>ImageToIcon</Product>
        <IsAotCompatible>false</IsAotCompatible>
    </PropertyGroup>

</Project>
